  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const pad = n => String(n).padStart(2, \"0\");\r",
          "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\r",
          "\r",
          "function nextDay(target) { // 0 = Sunday ... 6 = Saturday\r",
          "    const d = new Date();\r",
          "    d.setDate(d.getDate() + (((target - d.getDay() + 7) % 7) || 7));\r",
          "    return fmt(d);\r",
          "}\r",
          "\r",
          "pm.environment.set(\"today\", fmt(new Date()));\r",
          "pm.environment.set(\"next_sunday\", nextDay(0));\r",
          "pm.environment.set(\"next_monday\", nextDay(1));\r",
          "pm.environment.set(\"next_tuesday\", nextDay(2));"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "pm.test(\"Response is JSON with a success flag\", () => {\r",
          "    pm.response.to.be.json;\r",
          "    pm.expect(pm.response.json()).to.have.property(\"success\");\r",
          "});\r",
          "\r",
          "pm.test(\"Error responses include a message\", () => {\r",
          "    const body = pm.response.json();\r",
          "    if (body.success === false) {\r",
          "        pm.expect(body).to.have.property(\"message\");\r",
          "    }\r",
          "});\r",
          "\r",
          "pm.test(\"Responds in under 1000 ms\", () => {\r",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
          "});"
        ],
        "type": "text/javascript"
      }
    }
  ]
